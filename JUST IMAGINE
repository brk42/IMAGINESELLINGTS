-- ============================
-- WHEELIE BAR
-- ============================

local WheelieBar_Connection = nil
local WheelieBar_Originals  = {}
local WHEELIE_TARGET_SIZE     = Vector3.new(1.2, 1.8, 0.9)
local WHEELIE_TARGET_ROTATION = Vector3.new(-139.218994140625, -60.93600082397461, -122.98500061035156)

local function WheelieBar_Apply(box)
    if not box:IsA("BasePart") then return end
    if not WheelieBar_Originals[box] then
        WheelieBar_Originals[box] = { Size = box.Size, CFrame = box.CFrame }
    end
    local position = box.Position
    pcall(function()
        box.Size = WHEELIE_TARGET_SIZE
        box.CFrame = CFrame.new(position) * CFrame.Angles(
            math.rad(WHEELIE_TARGET_ROTATION.X),
            math.rad(WHEELIE_TARGET_ROTATION.Y),
            math.rad(WHEELIE_TARGET_ROTATION.Z)
        )
    end)
end

local function WheelieBar_Process(obj)
    if obj.Name == "Box106" then
        task.wait(0.2)
        WheelieBar_Apply(obj)
    end
end

Tabs.Main:AddToggle("WheelieBar", {
    Title = "Wheelie Bar",
    Default = false,
    Callback = function(Value)
        if Value then
            WheelieBar_Originals = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj.Name == "Box106" then WheelieBar_Apply(obj) end
            end
            WheelieBar_Connection = workspace.DescendantAdded:Connect(WheelieBar_Process)
        else
            if WheelieBar_Connection then
                WheelieBar_Connection:Disconnect()
                WheelieBar_Connection = nil
            end
            for part, original in pairs(WheelieBar_Originals) do
                pcall(function()
                    if part and part.Parent then
                        part.Size   = original.Size
                        part.CFrame = original.CFrame
                    end
                end)
            end
            WheelieBar_Originals = {}
        end
    end
})

