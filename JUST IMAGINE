local Custom_Enabled = false
local Custom_Connection = nil
local Custom_Originals = {}

local Custom_Color = {
    Suspension = Color3.fromRGB(255, 0, 0),
    Stem       = Color3.fromRGB(255, 0, 0),
    Handlebar  = Color3.fromRGB(255, 255, 255),
    Grips      = Color3.fromRGB(255, 255, 255),
    MiddlePart = Color3.fromRGB(255, 0, 0),
    Deck       = Color3.fromRGB(255, 255, 255),
    WheelieBar = Color3.fromRGB(255, 255, 255),
    Body       = Color3.fromRGB(255, 255, 255),
}

local Custom_Groups = {
    ["FrontSuspension"] = "Suspension",
    ["BackSuspension"]  = "Suspension",
    ["Plane.001"]       = "Stem",
    ["Plane.005"]       = "Stem",
    ["Plane.007"]       = "Stem",
    ["Cylinder.004"]    = "Handlebar",
    ["Cylinder.006"]    = "Grips",
    ["Cylinder.007"]    = "Grips",
    ["2"]               = "MiddlePart",
    ["2.001"]           = "MiddlePart",
    ["imagetostl_mesh1"]= "MiddlePart",
    ["Untitled"]        = "Deck",
    ["Box106"]          = "WheelieBar",
    ["Plane.002"]       = "Body",
    ["Plane.012"]       = "Body",
}

local function Custom_GetColorFor(obj)
    local group = Custom_Groups[obj.Name]
    if group then
        return Custom_Color[group]
    end
    local lower = obj.Name:lower()
    if lower:find("brake", 1, true)  then return Custom_Color.MiddlePart end
    if lower:find("fender", 1, true) then return Custom_Color.Body       end
    return nil
end

local function Custom_ProcessPart(obj)
    if not Custom_Enabled then return end
    if not obj:IsA("BasePart") then return end
    if VESC_Destroy[obj.Name] then
        pcall(function() obj:Destroy() end)
        return
    end
    local color = Custom_GetColorFor(obj)
    if color then
        if not Custom_Originals[obj] then
            Custom_Originals[obj] = obj.Color
        end
        pcall(function() obj.Color = color end)
    end
end

local function Custom_ApplyAll()
    if not Custom_Enabled then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        Custom_ProcessPart(obj)
    end
end

local function Custom_Restore()
    for part, originalColor in pairs(Custom_Originals) do
        pcall(function()
            if part and part.Parent then
                part.Color = originalColor
            end
        end)
    end
    Custom_Originals = {}
end

