-- ============================

Tabs.Main:AddSection("Camera")

local Stretch_Connection = nil
local Stretch_Resolution = 0.80

local function ApplyStretch()
    local Camera = workspace.CurrentCamera
    if not Camera then return end
    Stretch_Connection = RunService.RenderStepped:Connect(function()
        Camera.CFrame = Camera.CFrame * CFrame.new(
            0, 0, 0,
            1, 0, 0,
            0, Stretch_Resolution, 0,
            0, 0, 1
        )
    end)
end

Tabs.Main:AddToggle("StretchedRes", {
    Title = "Stretched Resolution",
    Default = false,
    Callback = function(Value)
        if Value then
            ApplyStretch()
        else
            if Stretch_Connection then
                Stretch_Connection:Disconnect()
                Stretch_Connection = nil
            end
        end
    end
})

Tabs.Main:AddSlider("StretchAmount", {
    Title = "Stretch Amount",
    Default = 0.80,
    Min = 0.50,
    Max = 1.00,
    Rounding = 2,
