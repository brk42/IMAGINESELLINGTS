-- ============================
-- RAINBOW SYSTEM
-- ============================

local RainbowParts = {}
local RainbowConnection = nil

local function StartRainbowLoop()
    if RainbowConnection then return end
    RainbowConnection = RunService.RenderStepped:Connect(function()
        local hue = (tick() * 0.3) % 1
        local c = Color3.fromHSV(hue, 1, 1)
        for part in pairs(RainbowParts) do
            if part and part.Parent then
                pcall(function() part.Color = c end)
            end
        end
    end)
end

local function StopRainbowLoop()
    if RainbowConnection then
        RainbowConnection:Disconnect()
        RainbowConnection = nil
    end
end

local function AddRainbowPart(part, owner)
    if not part:IsA("BasePart") then return end
    if RainbowParts[part] then return end
    RainbowParts[part] = { Original = part.Color, Owner = owner }
    StartRainbowLoop()
end

local function RemoveRainbowByOwner(owner)
    for part, data in pairs(RainbowParts) do
        if data.Owner == owner then
            pcall(function()
                if part and part.Parent then
                    part.Color = data.Original
                end
            end)
            RainbowParts[part] = nil
        end
    end
    if next(RainbowParts) == nil then StopRainbowLoop() end
end

