-- ============================
-- ROBUST RAYFIELD LOADER
-- ============================

-- Prevent double-loading if the user runs the script twice
if _G.__VESCHubLoaded then
    pcall(function() Rayfield:Destroy() end)
end
_G.__VESCHubLoaded = true

local Rayfield

-- Try multiple mirrors in case one is down
local RAYFIELD_URLS = {
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua",
}

local lastErr
for _, url in ipairs(RAYFIELD_URLS) do
    local ok, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if ok and result then
        Rayfield = result
        break
    else
        lastErr = result
        warn("[VESC Hub] Rayfield load failed from " .. url .. ": " .. tostring(result))
    end
end

if not Rayfield then
    return error("[VESC Hub] Could not load Rayfield. Error: " .. tostring(lastErr))
end

-- Wait for CoreGui / PlayerGui to be ready (fixes empty menu)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

if not LocalPlayer:FindFirstChild("PlayerGui") then
    LocalPlayer:WaitForChild("PlayerGui", 10)
end

-- Small settle delay so Rayfield's ScreenGui finishes parenting
task.wait(0.5)

