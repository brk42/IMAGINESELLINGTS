Tabs.Main:AddSection("Underglow")

local Underglow_Enabled = false
local Underglow_Rainbow = false
local Underglow_Color = Color3.fromRGB(0, 220, 255)
local MyScooter = nil

local function FindMyScooter()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("kukirin", 1, true) then
            local ownerName = nil
            local attrOwner = obj:GetAttribute("Owner")
                or obj:GetAttribute("ScooterOwner")
                or obj:GetAttribute("owner")
                or obj:GetAttribute("scooterOwner")
            if attrOwner then ownerName = tostring(attrOwner) end

            if not ownerName then
                local ownerPart = obj:FindFirstChild("ScooterOwner")
                    or obj:FindFirstChild("Owner")
                    or obj:FindFirstChild("owner")
                    or obj:FindFirstChild("scooterOwner")
                if ownerPart then
                    if ownerPart:IsA("ObjectValue") then
                        if ownerPart.Value then ownerName = ownerPart.Value.Name end
                    elseif ownerPart:IsA("StringValue") then
                        ownerName = ownerPart.Value
                    end
                end
            end
            if not ownerName then
                for _, child in ipairs(obj:GetChildren()) do
                    if child.Name:lower():find("owner", 1, true) then
                        if child:IsA("ObjectValue") and child.Value then ownerName = child.Value.Name break
                        elseif child:IsA("StringValue") then ownerName = child.Value break end
                    end
                end
            end
            if ownerName and ownerName == LocalPlayer.Name then return obj end
        end
    end
    return nil
end

local function GetUnderglowFolders()
    local folders = {}
    local global = Workspace:FindFirstChild("RainbowUnderglowLocal")
    if global then table.insert(folders, global) end
    if MyScooter then
        local inner = MyScooter:FindFirstChild("RainbowUnderglowLocal")
        if inner then table.insert(folders, inner) end
    end
    return folders
end

local function EnableUnderglowAttribute(scooter)
    if not scooter then return end
    pcall(function() scooter:SetAttribute("RainbowUnderglow", true) end)
    pcall(function() scooter:SetAttribute("RainbowUnderglowEnabled", true) end)
    pcall(function() scooter:SetAttribute("Underglow", true) end)
    pcall(function() scooter:SetAttribute("UnderglowEnabled", true) end)
end

local function CollectUnderglowParts()
    local parts = {}
    if MyScooter then
        for _, obj in ipairs(MyScooter:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "Underglow" or obj.Name == "UnderglowPool") then
                table.insert(parts, obj)
            end
        end
    end
    for _, folder in ipairs(GetUnderglowFolders()) do
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("BasePart") and (obj.Name == "Underglow" or obj.Name == "UnderglowPool") then
                table.insert(parts, obj)
            end
        end
    end
    return parts
end

local function ApplyColorToPart(obj, col)
    pcall(function() obj.Color = col end)
    for _, c in ipairs(obj:GetDescendants()) do
        if c:IsA("Light") then
            c.Enabled = true
            c.Color = col
        elseif c:IsA("ImageLabel") then
            c.Visible = true
            c.ImageColor3 = col
        end
    end
end

local Underglow_RainbowConn = nil

local function StartUnderglowRainbow()
    if Underglow_RainbowConn then return end
    Underglow_RainbowConn = RunService.RenderStepped:Connect(function()
        if not Underglow_Enabled or not Underglow_Rainbow then return end
        if not MyScooter then return end
        local col = Color3.fromHSV((tick() * 0.3) % 1, 1, 1)
        for _, obj in ipairs(CollectUnderglowParts()) do
            ApplyColorToPart(obj, col)
        end
    end)
end

local function StopUnderglowRainbow()
    if Underglow_RainbowConn then
        Underglow_RainbowConn:Disconnect()
        Underglow_RainbowConn = nil
    end
end

local LastStaticColor = nil

local function ApplyUnderglowStatic(force)
    if not MyScooter or not Underglow_Enabled then return end
    if Underglow_Rainbow then return end
    local col = Underglow_Color
    if not force and LastStaticColor == col then return end
    LastStaticColor = col
    for _, obj in ipairs(CollectUnderglowParts()) do
        ApplyColorToPart(obj, col)
    end
end

local function HideUnderglow()
    for _, obj in ipairs(CollectUnderglowParts()) do
        for _, c in ipairs(obj:GetDescendants()) do
            if c:IsA("Light") then c.Enabled = false
            elseif c:IsA("ImageLabel") then c.Visible = false end
        end
    end
    LastStaticColor = nil
end

task.spawn(function()
    while true do
        task.wait(1)
        MyScooter = FindMyScooter()
        if MyScooter and Underglow_Enabled then
            EnableUnderglowAttribute(MyScooter)
            if not Underglow_Rainbow then
                ApplyUnderglowStatic(false)
            end
        end
    end
end)

Tabs.Main:AddToggle("Underglow", {
    Title = "Underglow",
    Default = false,
    Callback = function(Value)
        Underglow_Enabled = Value
        if Value then
            MyScooter = FindMyScooter()
            if MyScooter then EnableUnderglowAttribute(MyScooter) end
            if Underglow_Rainbow then
                StartUnderglowRainbow()
            else
                LastStaticColor = nil
                ApplyUnderglowStatic(true)
            end
        else
            StopUnderglowRainbow()
            HideUnderglow()
        end
    end
})

Tabs.Main:AddToggle("UnderglowRainbow", {
    Title = "Underglow Rainbow",
    Default = false,
    Callback = function(Value)
        Underglow_Rainbow = Value
        if Value then
            if Underglow_Enabled then StartUnderglowRainbow() end
        else
            StopUnderglowRainbow()
            if Underglow_Enabled then
                LastStaticColor = nil
                ApplyUnderglowStatic(true)
            end
        end
    end
})

Tabs.Main:AddColorpicker("UnderglowColor", {
    Title = "Underglow Color",
    Default = Color3.fromRGB(0, 220, 255),
    Callback = function(Value)
        Underglow_Color = Value
        Underglow_Rainbow = false
        StopUnderglowRainbow()
        if Options.UnderglowRainbow then
            Options.UnderglowRainbow:SetValue(false)
        end
        if Underglow_Enabled then
            LastStaticColor = nil
            ApplyUnderglowStatic(true)
        end
    end
})



