-- UNDERGLOW (owner-aware, starts ON)
-- ============================

local Underglow_Enabled = true
local Underglow_Color = Color3.fromRGB(0, 220, 255)
local MyScooter = nil

local function FindMyScooter()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name:lower():find("kukirin", 1, true) then
            local ownerName = nil
            local attrOwner = obj:GetAttribute("Owner")
                or obj:GetAttribute("ScooterOwner")
                or obj:GetAttribute("owner")
                or obj:GetAttribute("scooterOwner")
            if attrOwner then ownerName = tostring(attrOwner) end

            if not ownerName then
                local ownerPart = obj:FindFirstChild("ScooterOwner")
                    or obj:FindFirstChild("Owner")
                    or obj:FindFirstChild("owner")
                    or obj:FindFirstChild("scooterOwner")
                if ownerPart then
                    if ownerPart:IsA("ObjectValue") then
                        if ownerPart.Value then ownerName = ownerPart.Value.Name end
                    elseif ownerPart:IsA("StringValue") then
                        ownerName = ownerPart.Value
                    end
                end
            end

            if not ownerName then
                for _, child in ipairs(obj:GetChildren()) do
                    if child.Name:lower():find("owner", 1, true) then
                        if child:IsA("ObjectValue") and child.Value then
                            ownerName = child.Value.Name
                            break
                        elseif child:IsA("StringValue") then
                            ownerName = child.Value
                            break
                        end
                    end
                end
            end

            if ownerName and ownerName == LocalPlayer.Name then
                return obj
            end
        end
    end
    return nil
end

local function GetUnderglowFolders()
    local folders = {}
    local global = Workspace:FindFirstChild("RainbowUnderglowLocal")
    if global then table.insert(folders, global) end
    if MyScooter then
        local inner = MyScooter:FindFirstChild("RainbowUnderglowLocal")
        if inner then table.insert(folders, inner) end
    end
    return folders
end

local function EnableUnderglowAttribute(scooter)
    if not scooter then return end
    pcall(function() scooter:SetAttribute("RainbowUnderglow", true) end)
    pcall(function() scooter:SetAttribute("RainbowUnderglowEnabled", true) end)
    pcall(function() scooter:SetAttribute("Underglow", true) end)
    pcall(function() scooter:SetAttribute("UnderglowEnabled", true) end)
end

local function ApplyUnderglow()
    if not MyScooter then return end

    for _, obj in ipairs(MyScooter:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Underglow" or obj.Name == "UnderglowPool") then
            for _, c in ipairs(obj:GetDescendants()) do
                if c:IsA("Light") then
                    c.Enabled = Underglow_Enabled
                    if Underglow_Enabled then c.Color = Underglow_Color end
                elseif c:IsA("ImageLabel") then
                    c.Visible = Underglow_Enabled
                    if Underglow_Enabled then c.ImageColor3 = Underglow_Color end
                end
            end
            if Underglow_Enabled then obj.Color = Underglow_Color end
        end
    end

    for _, folder in ipairs(GetUnderglowFolders()) do
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("BasePart") and (obj.Name == "Underglow" or obj.Name == "UnderglowPool") then
                for _, c in ipairs(obj:GetDescendants()) do
                    if c:IsA("Light") then
                        c.Enabled = Underglow_Enabled
                        if Underglow_Enabled then c.Color = Underglow_Color end
                    elseif c:IsA("ImageLabel") then
                        c.Visible = Underglow_Enabled
                        if Underglow_Enabled then c.ImageColor3 = Underglow_Color end
                    end
                end
                if Underglow_Enabled then obj.Color = Underglow_Color end
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        MyScooter = FindMyScooter()
        if MyScooter then
            EnableUnderglowAttribute(MyScooter)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if Underglow_Enabled and MyScooter then
        ApplyUnderglow()
        task.defer(ApplyUnderglow)
    end
end)

Tabs.Main:AddToggle("Underglow", {
