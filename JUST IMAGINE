Tabs.Main:AddSection("Keystrokes")

local Keystrokes_Enabled = false
local Keystrokes_Gui = nil
local Keystrokes_Conn = nil

local function BuildKeystrokes()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")

    ScreenGui.Name = "KeystrokesGui"
    ScreenGui.Parent = game:GetService("CoreGui")
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.ResetOnSpawn = false

    Frame.Parent = ScreenGui
    Frame.BackgroundTransparency = 1
    Frame.Position = UDim2.new(0.05, 0, 0.55, 0)
    Frame.Size = UDim2.new(0, 172, 0, 190)

    local KEY_BG    = Color3.fromRGB(25, 25, 28)
    local KEY_BG_TR = 0.35
    local PRESS_BG  = Color3.fromRGB(235, 235, 240)
    local TEXT_COL  = Color3.fromRGB(235, 235, 240)
    local PRESS_TXT = Color3.fromRGB(20, 20, 24)

    local function makeKey(name, pos, size, label)
        local k = Instance.new("TextLabel")
        k.Name = name
        k.Parent = Frame
        k.BackgroundColor3 = KEY_BG
        k.BackgroundTransparency = KEY_BG_TR
        k.BorderSizePixel = 0
        k.Position = pos
        k.Size = size
        k.Font = Enum.Font.GothamBold
        k.Text = label
        k.TextColor3 = TEXT_COL
        k.TextSize = 20
        Instance.new("UICorner", k).CornerRadius = UDim.new(0, 6)
        return k
    end

    local wkey = makeKey("wkey", UDim2.new(0, 58, 0, 0),  UDim2.new(0, 56, 0, 46), "W")
    local akey = makeKey("akey", UDim2.new(0, 0,  0, 48), UDim2.new(0, 56, 0, 46), "A")
    local skey = makeKey("skey", UDim2.new(0, 58, 0, 48), UDim2.new(0, 56, 0, 46), "S")
    local dkey = makeKey("dkey", UDim2.new(0, 116,0, 48), UDim2.new(0, 56, 0, 46), "D")
    local lmb  = makeKey("lmb",  UDim2.new(0, 0,   0, 96), UDim2.new(0, 86, 0, 46), "LMB")
    local rmb  = makeKey("rmb",  UDim2.new(0, 86,  0, 96), UDim2.new(0, 86, 0, 46), "RMB")
    local ctrl = makeKey("ctrl", UDim2.new(0, 0,   0, 144), UDim2.new(0, 172, 0, 46), "CTRL")

    do
        local gui = Frame
        local dragging, dragInput, dragStart, startPos
        gui.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = gui.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        gui.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                gui.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    local function setKey(key, pressed)
        if pressed then
            key.BackgroundColor3 = PRESS_BG
            key.TextColor3 = PRESS_TXT
        else
            key.BackgroundColor3 = KEY_BG
            key.TextColor3 = TEXT_COL
        end
    end

    Keystrokes_Conn = RunService.Heartbeat:Connect(function()
        if not Keystrokes_Enabled then return end
        setKey(wkey, UserInputService:IsKeyDown(Enum.KeyCode.W))
        setKey(akey, UserInputService:IsKeyDown(Enum.KeyCode.A))
        setKey(skey, UserInputService:IsKeyDown(Enum.KeyCode.S))
        setKey(dkey, UserInputService:IsKeyDown(Enum.KeyCode.D))
        setKey(lmb,  UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1))
        setKey(rmb,  UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
        local ctrlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        setKey(ctrl, ctrlDown)
    end)

    Keystrokes_Gui = ScreenGui
end

local function DestroyKeystrokes()
    if Keystrokes_Gui then pcall(function() Keystrokes_Gui:Destroy() end) Keystrokes_Gui = nil end
    if Keystrokes_Conn then pcall(function() Keystrokes_Conn:Disconnect() end) Keystrokes_Conn = nil end
end

Tabs.Main:AddToggle("Keystrokes", {
    Title = "Keystrokes",
    Default = false,
    Callback = function(Value)
        Keystrokes_Enabled = Value
        if Value then BuildKeystrokes() else DestroyKeystrokes() end
    end
})

-- ============================
-- STRETCHED RESOLUTION
-- ============================

Tabs.Main:AddSection("Camera")

local Stretch_Connection = nil
local Stretch_Resolution = 0.80

local function ApplyStretch()
    local Camera = workspace.CurrentCamera
    if not Camera then return end
    Stretch_Connection = RunService.RenderStepped:Connect(function()
        Camera.CFrame = Camera.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, Stretch_Resolution, 0, 0, 0, 1)
    end)
end

Tabs.Main:AddToggle("StretchedRes", {
    Title = "Stretched Resolution",
    Default = false,
    Callback = function(Value)
        if Value then
            ApplyStretch()
        else
            if Stretch_Connection then
                Stretch_Connection:Disconnect()
                Stretch_Connection = nil
            end
        end
    end
})

Tabs.Main:AddSlider("StretchAmount", {
    Title = "Stretch Amount",
    Default = 0.80,
    Min = 0.50,
    Max = 1.00,
    Rounding = 2,
    Callback = function(Value)
        Stretch_Resolution = Value
        if Stretch_Connection then
            Stretch_Connection:Disconnect()
            Stretch_Connection = nil
            ApplyStretch()
        end
    end
})

