-- ============================
-- RECOLOR TOGGLE FACTORY
-- ============================

local function MakeRecolorToggle(config)
    local connection = nil
    local originals  = {}

    local function resolveColor(role)
        if role == "suspension" then return config.Suspension end
        if role == "footrest"   then return config.Footrest   end
        if role == "deck"       then return config.Deck       end
        if role == "cables"     then return config.Cables     end
        if role == "bars"       then return config.Bars       end
        if role == "grips"      then return config.Grips      end
        if role == "brakes"     then return config.Brakes     end
        if role == "stem"       then return config.Stem       end
        return nil
    end

    local function processPart(obj)
        if not obj:IsA("BasePart") then return end
        if VESC_Destroy[obj.Name] then
            pcall(function() obj:Destroy() end)
            return
        end
        local role = ROLES[obj.Name]
        if not role then return end
        local color = resolveColor(role)
        if not color then return end
        if not originals[obj] then originals[obj] = obj.Color end
        pcall(function() obj.Color = color end)
    end

    Tabs.Main:AddToggle(config.Flag, {
        Title = config.Name,
        Default = false,
        Callback = function(Value)
            if Value then
                originals = {}
                for _, obj in ipairs(workspace:GetDescendants()) do processPart(obj) end
                connection = workspace.DescendantAdded:Connect(processPart)
            else
                if connection then connection:Disconnect() connection = nil end
                for part, originalColor in pairs(originals) do
                    pcall(function()
                        if part and part.Parent then part.Color = originalColor end
                    end)
                end
                originals = {}
            end
        end
    })
end

