-- ============================
-- RECOLOR TOGGLE FACTORY
-- ============================

local function MakeRecolorToggle(config)
    local connection = nil
    local originals  = {}

    local function getNameColor(obj)
        if config.BodyOverride and config.BodyOverride[obj.Name] then
            return config.Body
        end
        if config.AccentOverride and config.AccentOverride[obj.Name] then
            return config.Accent
        end
        if config.ExactAccent and config.ExactAccent[obj.Name] then
            return config.Accent
        end
        if config.ExactBody and config.ExactBody[obj.Name] then
            return config.Body
        end
        if ACCENT_PARTS[obj.Name] then return config.Accent end
        if BODY_PARTS[obj.Name]   then return config.Body   end
        if config.Patterns then
            for pattern, kind in pairs(config.Patterns) do
                if obj.Name:lower():find(pattern:lower(), 1, true) then
                    if kind == "accent" then return config.Accent end
                    if kind == "body"   then return config.Body   end
                end
            end
        end
        return nil
    end

    local function processPart(obj)
        if not obj:IsA("BasePart") then return end
        if VESC_Destroy[obj.Name] then
            pcall(function() obj:Destroy() end)
            return
        end
        local color = getNameColor(obj)
        if color then
            if not originals[obj] then
                originals[obj] = obj.Color
            end
            pcall(function() obj.Color = color end)
        end
    end

    Tabs.Main:AddToggle(config.Flag, {
        Title = config.Name,
        Default = false,
        Callback = function(Value)
            if Value then
                originals = {}
                for _, obj in ipairs(workspace:GetDescendants()) do processPart(obj) end
                connection = workspace.DescendantAdded:Connect(processPart)
            else
                if connection then connection:Disconnect() connection = nil end
                for part, originalColor in pairs(originals) do
                    pcall(function()
                        if part and part.Parent then
                            part.Color = originalColor
                        end
                    end)
                end
                originals = {}
            end
        end
    })
end

